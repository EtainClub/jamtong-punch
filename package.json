{
  "name": "jamtong-punch",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "validate": "tsx scripts/validate-content.ts",
    "rebuild-derived": "tsx scripts/rebuild-derived.ts",
    "grant-ops": "tsx scripts/grant-ops.ts",
    "seed-dev": "tsx scripts/seed-dev.ts",
    "deploy:firebase": "bash scripts/deploy-firebase.sh",
    "deploy:apphosting": "firebase deploy --only apphosting:jamtong-punch --project jamtong-punch",
    "deploy:cms-bootstrap": "CMS_BOOTSTRAP=1 pnpm preflight:prod && pnpm deploy:apphosting",
    "configure:ttl": "bash scripts/configure-ttl.sh",
    "configure:schedulers": "bash scripts/create-schedulers.sh",
    "resume:schedulers": "bash scripts/resume-schedulers.sh",
    "provision:storage": "tsx scripts/provision-storage.ts",
    "preflight:prod": "tsx scripts/preflight-production.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:backend": "FIREBASE_CONFIG='{\"projectId\":\"jamtong-punch-test\"}' firebase emulators:exec --project jamtong-punch-test --only firestore \"vitest run tests/rollup.emulator.test.ts tests/content.emulator.test.ts tests/participation.emulator.test.ts tests/anchor.emulator.test.ts\"",
    "check": "pnpm validate && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@upvu/dsteem": "^1.1.7",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^9.15.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
